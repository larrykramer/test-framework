<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.larrykramer</groupId>
    <artifactId>test-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>test-suite</artifactId>
  <packaging>jar</packaging>

  <name>Test Framework - Test Suite Module</name>
  <description>Module for the Test Framework's test suite</description>

  <properties>
    <!--
      forkCount for parallel test execution:
      - Set to '1' for debugging (e.g., `<forkCount>1</forkCount>`) to run tests in a single JVM.
      - Set to '0.5C' for parallel execution (e.g., `<forkCount>0.5C</forkCount>`), which means
        half the number of available CPU cores. This value is recommended for balancing
        browser-based test execution speed with system stability and reliability.
    -->
    <forkCount>0.5C</forkCount>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>test-framework-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <argLine>@{argLine}</argLine>
          <parallel>classes</parallel>
          <perCoreThreadCount>false</perCoreThreadCount>
          <forkCount>${forkCount}</forkCount>
          <reuseForks>true</reuseForks>
          <threadCount>1</threadCount>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
